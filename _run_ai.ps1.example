# 本地启动脚本模板（复制为 _run_ai.ps1 后填入自己的密钥）
# 注意：_run_ai.ps1 已在 .gitignore 中，真实密钥不要提交到仓库

$env:DB_PASSWORD = "你的数据库密码"
$env:AI_API_KEY  = "你的 SiliconFlow API Key"
$env:AI_BASE_URL = "https://api.siliconflow.cn/v1"
$env:AI_MODEL    = "Qwen/Qwen2.5-7B-Instruct"

Set-Location -LiteralPath "项目根目录"
& "python.exe" manage.py runserver 127.0.0.1:8000 --noreload
